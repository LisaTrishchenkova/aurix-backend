{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Aurix API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Aurix/bin/Debug/net9.0/Aurix.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Aurix",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "integratedTerminal"
        }
    ]
}
