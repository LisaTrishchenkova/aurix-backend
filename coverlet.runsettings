<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura,json,lcov</Format>
          <Include>[Aurix]*</Include>
          <Exclude>
            [xunit.*]*,
            [*.Tests]*,
            [*.Test]*,
            [Microsoft.*]*,
            [System.*]*,
            [Aurix]*Migrations*,
            [Aurix]*Models.Entities*,
            [Aurix]*Models.DTOs*,
            [Aurix]*Models.Requests*,
            [Aurix]*Models.Responses*,
            [Aurix]*Infrastructure*,
            [Aurix]Aurix.Program
          </Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
